            KeybindBtn.Text =

                "TP Home Key: [" .. tpKeybind.Name .. "]"

            KeybindBtn.TextColor3 =

                Config.Theme.TextDim

        end

        return

    end

    if gameProcessed then

        return

    end

    if input.UserInputType == Enum.UserInputType.Keyboard then

        if input.KeyCode == tpKeybind then

            teleportToHomePlot()

        end

    end

end)

